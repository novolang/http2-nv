// The `last_stream` of a GOAWAY that arrived, or `None`.
//
// What a retry decision reads: a stream ABOVE this number was never
// processed, so re-sending it cannot do the work twice — which is the
// one condition that makes a non-idempotent retry safe, and the one
// grpc-nv's `never_processed` is asking about.
//
// ```novo
// use h2conn
// use h2prelude
// use h2settings
//
// fn main() [io]
//     let c = h2conn.client(H2ViaAlpn, h2conn.default_limits(),
//                           h2settings.default_settings())
//     match h2conn.goaway_last_stream(c)
//         Some(n) => println("${n}")
//         None    => println("no goaway")
// ```
pub fn goaway_last_stream(c: H2Conn) -> ?Int []
    todo("http2-nv.h2conn.goaway_last_stream")

// Was this stream certainly never processed by the peer?
//
// True for a stream above a received GOAWAY's `last_stream` and for one
// the peer reset with REFUSED_STREAM, and false for everything else.
// Published here because grpc-nv asks exactly this question of its
// transport and answers it today from a fault type it invents; with
// this package underneath, the two agree by construction instead of by
// a table somebody keeps in step.
//
// ```novo
// use h2conn
// use h2prelude
// use h2settings
//
// fn main() [io]
//     let c = h2conn.client(H2ViaAlpn, h2conn.default_limits(),
//                           h2settings.default_settings())
//     println("${h2conn.never_processed(c, 9)}")
// ```
pub fn never_processed(c: H2Conn, stream: Int) -> Bool []
    todo("http2-nv.h2conn.never_processed")

